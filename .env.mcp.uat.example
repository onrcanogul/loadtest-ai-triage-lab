# UAT environment - copy to .env.mcp.uat and fill in. Never commit the real file.
# GRAFANA_URL: the corporate Grafana that has UAT's Loki as a datasource (reachable from your machine / VPN).
#   docker mode: use the real hostname, not host.docker.internal.   binary mode: same.
GRAFANA_URL=https://grafana.uat.example.internal
# Viewer service account token for THAT Grafana, scoped to the UAT Loki datasource (ask the Grafana admins).
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxx
# Optional, corporate network:
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1,.example.internal
# SSL_CERT_FILE=/path/to/corporate-ca.pem
# MCP_GRAFANA_BIN=/usr/local/bin/mcp-grafana   # docker-free mode
