# Lab environment - generated by scripts/create-grafana-sa-token.sh (writes .env.mcp.lab)
# Lab is the only environment where the MCP server may fall back to `docker run mcp/grafana`
# (the lab stack is docker compose anyway). With an mcp-grafana binary installed it runs that instead.
GRAFANA_URL=http://host.docker.internal:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxx
# MCP_GRAFANA_BIN=/usr/local/bin/mcp-grafana   # optional: binary instead of docker
